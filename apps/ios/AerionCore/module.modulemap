// 暴露 Rust 内核的 C-ABI 头给 Swift：PacketTunnel 扩展里 `import AerionCore`。
// aerion_core.h 由 CI 从 rust/aerion-core/include/aerion_core.h 复制到本目录（勿手动提交拷贝）。
module AerionCore {
    header "aerion_core.h"
    export *
}

// kern_control 系统头垫片（utun fd 扫描用）。标 [system] 抑制“非模块化系统头”告警。
module AerionSys [system] {
    header "aerion_sys.h"
    export *
}
